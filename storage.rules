rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function paperIsPublished(paperId) {
      return firestore.get(/databases/(default)/documents/previousYearPapers/$(paperId)).data.published == true;
    }

    match /previousYearPapers/{paperId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || paperIsPublished(paperId));
      allow create, update: if isAdmin()
        && fileName in ['question-paper.pdf', 'answer-key.pdf']
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
